VPS_PORT=22
VPS_APP_PATH=/opt/presupuesto-familiar

# Completa estos valores antes de usarlos en GitHub:
VPS_HOST=TU_IP_O_HOST
VPS_USER=TU_USUARIO_SSH
REGISTRY_USERNAME=TU_USUARIO_GITHUB
REGISTRY_PASSWORD=TU_TOKEN_GHCR

# Los secretos de aplicacion no se guardan en GitHub.
# Crea /opt/presupuesto-familiar/.env.production directamente en el VPS.
